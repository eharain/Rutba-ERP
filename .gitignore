/.vs
/pos-desk/.vs
/generators/data
node
# The controller below is NO LONGER ignored: it is ordinary source, and
# rutba-core posRequire()s it at boot (src/modules/catalog.js), so a build
# without it crash-loops. Strapi was quieter about the same absence - it simply
# never registered the controller - which is why this went unnoticed for so
# long.
#
# routes/validator.js stays ignored deliberately. Both of its routes are
# declared `auth: false`, so committing it would publish
# /api/validator/validate/:uid and /api/validator/content-type-fields/:name as
# unauthenticated schema introspection on every deploy box - endpoints that
# have never actually existed there. rutba-core serves the same two handlers
# from its own descriptors, permission-gated. Add auth before un-ignoring.
/pos-strapi/src/api/utils/routes/validator.js
/pos-strapi/types/generated/*
/pos-strapi/src/.vs
/data
/pos-desk/package-lock.json
.next
/node_modules
node_modules
# npm's internal marker inside node_modules — not a real lockfile.
.package-lock.json
# NOTE: package-lock.json files are deliberately NOT ignored.  The deploy
# script builds from a fresh `git clone`, so a lockfile that never reaches
# the server forces npm to re-resolve every semver range against whatever
# node_modules happens to be lying around — which is how the 5.51 bump
# produced both ETARGET (stale offline cache had no @easypost/api 8.9.0)
# and ERESOLVE (stale styled-components/react-native peer graph).
.env
.env.*
!.env.example
/ssh-history.txt
/pos-strapi/database/migrations/20260306-rutba-cms-seed.js
/pos-strapi/scripts/generate-cms-seed-excel.js
/pos-strapi/scripts/rutba-cms-seed-data.xlsx
/pos-strapi/scripts/~$rutba-cms-seed-data.xlsx
/dev-error.log
/dev-output.log
/next
/scripts/seed-cms-pages.js
