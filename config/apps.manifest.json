    {"key":"control","unit":"rutba_control","workspace":"apps/inventory/control","npm":"@rutba/control","kind":"app","port":4017,"category":"inventory","envPrefix":"CONTROL","urlVar":"NEXT_PUBLIC_CONTROL_URL","domains":["control"],"descriptorScan":true},
    {"key":"seed","unit":"rutba_seed","workspace":"apps/admin/seed","npm":"@rutba/seed","kind":"app","port":4018,"category":"admin","envPrefix":"SEED","urlVar":"NEXT_PUBLIC_SEED_URL","domains":["seed"],"descriptorScan":true},
    {"key":"campaigns","unit":"rutba_campaigns","workspace":"apps/content/campaigns","npm":"@rutba/campaigns","kind":"app","port":4019,"category":"content","envPrefix":"CAMPAIGNS","urlVar":"NEXT_PUBLIC_CAMPAIGNS_URL","domains":["campaigns"],"descriptorScan":true},
    {"key":"mail","unit":"rutba_mail","workspace":"apps/content/mail","npm":"@rutba/mail","kind":"app","port":4021,"category":"content","envPrefix":"MAIL","urlVar":"NEXT_PUBLIC_MAIL_URL","domains":["mail"],"descriptorScan":true},
    {"key":"console","unit":"rutba_console","workspace":"apps/admin/console","npm":"@rutba/console","kind":"app","port":4022,"category":"admin","envPrefix":"CONSOLE","urlVar":"NEXT_PUBLIC_CONSOLE_URL","domains":["console"],"descriptorScan":true},
    {"key":"helpdesk","unit":"rutba_helpdesk","workspace":"apps/sales/helpdesk","npm":"@rutba/helpdesk","kind":"app","port":4023,"category":"sales","envPrefix":"HELPDESK","urlVar":"NEXT_PUBLIC_HELPDESK_URL","domains":["helpdesk"],"descriptorScan":true},
    {
      "key": "marketplace-worker",
      "unit": "rutba_marketplace_worker",
      "workspace": "apps/sales/marketplace",
      "kind": "worker",
      "port": null,
      "envPrefix": "MARKETPLACE",
      "domains": [],
      "launcher": false,
      "descriptorScan": false,
      "note": "Background sync worker sharing the apps/sales/marketplace workspace. No HTTP surface, so no port and no URL var; the registry records its port as '-'."
    }
  ],

  "packages": [
    {"path":"packages/api-provider","npm":"@rutba/api-provider"},
    {"path":"packages/shared","npm":"@rutba/shared"},
    {"path":"packages/sync","npm":"@rutba/sync"},
    {"path":"packages/video","npm":"@rutba/video"},
    {"path":"packages/strapi-api-pro","npm":"strapi-api-pro"},
    {"path":"packages/strapi-provider-upload-media","npm":"strapi-provider-upload-media"}
  ],

  "domainsWithoutApps": [
    {
      "domain": "delivery",
      "status": "undecided",
      "why": "Present in domains.json with no app, no workspace and no catalogue entry. Either a planned domain or vestigial — flagged in the registry drift report (A3) as a decision that is still owed."
    }
  ]
}
