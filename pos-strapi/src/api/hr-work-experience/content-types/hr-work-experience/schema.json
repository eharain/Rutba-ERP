{
  "kind": "collectionType",
  "collectionName": "hr_work_experiences",
  "info": {
    "singularName": "hr-work-experience",
    "pluralName": "hr-work-experiences",
    "displayName": "HR Work Experience",
    "description": "Employee prior work experience"
  },
