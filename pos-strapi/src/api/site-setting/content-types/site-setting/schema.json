{
  "kind": "collectionType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Settings",
    "description": "Per-app site configuration: branding, SEO defaults, promo banner, navigation labels. One row per app (keyed by app_slug), with one row flagged is_default as the fallback."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "app_slug": {
      "type": "string",
      "unique": true,
      "description": "App this row configures (e.g. web, pos, cms). Resolution is by app_slug first, then the is_default row. Left empty the row is only reachable by documentId."
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Fallback row used when no app_slug matches. Exactly one row carries this — setting it on a row clears it on the others."
    },
    "site_name": {
      "type": "string",
      "required": true,
      "default": "Rutba.pk"
    },
    "site_tagline": {
      "type": "string",
      "default": "Premium Products at Exceptional Prices"
    },
    "site_description": {
      "type": "text",
      "default": "Your ultimate destination for premium products at exceptional prices"
    },
    "site_logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "header_promo_enabled": {
      "type": "boolean",
      "default": false
    },
    "header_promo_text": {
      "type": "string"
    },
    "header_promo_cta_text": {
      "type": "string"
    },
    "header_promo_cta_url": {
      "type": "string"
    },
    "nav_explore_products_label": {
      "type": "string",
      "default": "Explore Products"
    },
    "nav_explore_brands_label": {
      "type": "string",
      "default": "Explore Brands"
    },
    "nav_login_label": {
      "type": "string",
      "default": "Login or Register"
    },
    "nav_search_placeholder": {
      "type": "string",
      "default": "Search Products"
    },
    "site_url": {
      "type": "string"
    },
    "default_meta_title": {
      "type": "string"
    },
    "default_meta_description": {
      "type": "text"
    },
    "default_meta_keywords": {
      "type": "string"
    },
    "default_og_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "twitter_handle": {
      "type": "string"
    },
    "default_footer": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::cms-footer.cms-footer"
    }
  }
}
