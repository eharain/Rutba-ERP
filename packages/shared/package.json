{
  "name": "@rutba/shared",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "validate:exports": "node ./scripts/validate-exports.mjs",
    "validate": "npm run validate:exports",
    "build": "npm run validate",
    "test:core": "node core/parties/test.js && node core/catalog/test.js",
    "test": "npm run test:core"
  },
  "dependencies": {
    "@rutba/api-provider": "1.0.0"
  },
  "exports": {
    "./lib/*": [
      "./lib/*",
      "./lib/*.js"
    ],
    "./context/*": [
      "./context/*",
      "./context/*.js"
    ],
    "./components/*": [
      "./components/*",
      "./components/*.js"
    ],
    "./hooks/*": [
      "./hooks/*",
      "./hooks/*.js"
    ],
    "./domain/*": [
      "./context/domain/*",
      "./context/domain/*.js"
    ],
    "./core/*": [
      "./core/*/index.js",
      "./core/*.js",
      "./core/*"
    ],
    "./styles/*": "./styles/*"
  }
}
