{
  "kind": "collectionType",
  "collectionName": "hr_departments",
  "info": {
    "singularName": "hr-department",
    "pluralName": "hr-departments",
    "displayName": "HR Department",
    "description": "Company departments"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "head": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "employees": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::hr-employee.hr-employee",
      "mappedBy": "department"
    },
    "teams": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::hr-team.hr-team",
      "mappedBy": "department"
    },
    "parent_department": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::hr-department.hr-department",
      "inversedBy": "child_departments"
    },
    "child_departments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::hr-department.hr-department",
      "mappedBy": "parent_department"
    },
    "division": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::hr-division.hr-division"
    },
    "cost_center": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::hr-cost-center.hr-cost-center"
    }
  }
}
