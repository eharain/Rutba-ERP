{
  "kind": "collectionType",
  "collectionName": "cmp_recipients",
  "info": {
    "singularName": "cmp-recipient",
    "pluralName": "cmp-recipients",
    "displayName": "Campaign Recipient",
    "description": "One row per person per run — the attribution spine. Carries the merge data actually sent and the MTA message_uuid, which is what lets a delivery webhook find its way back to a contact. The volume table: plan retention before it grows."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "run": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cmp-run.cmp-run",
      "inversedBy": "recipients"
    },
    "crm_contact": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::crm-contact.crm-contact"
    },
    "person": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::person.person",
      "description": "Resolved by email at run time — folds campaign sends into the person email-identity spine (email-program 04/07)."
    },
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::customer.customer"
    },
    "email": {
      "type": "string",
      "required": true
    },
    "merge_data": {
      "type": "json",
      "description": "The exact per-recipient data handed to the MTA. Kept so a send can be explained after the fact."
    },
    "message_uuid": {
      "type": "string",
      "description": "MTA message uuid. The join key for inbound delivery webhooks."
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Queued",
        "Sent",
        "Deferred",
        "Bounced",
        "Complained",
        "Failed",
        "Dropped",
        "Suppressed",
        "Unsubscribed"
      ],
      "default": "Pending"
    },
    "sent_at": {
      "type": "datetime"
    },
    "opened_at": {
      "type": "datetime",
      "description": "First recorded open (local tracking pixel)."
    },
    "clicked_at": {
      "type": "datetime",
      "description": "First recorded click on any tracked link."
    },
    "last_event_at": {
      "type": "datetime"
    },
    "error": {
      "type": "text"
    },
    "events": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::cmp-event.cmp-event",
      "mappedBy": "recipient"
    }
  }
}
