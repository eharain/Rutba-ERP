    },
    "start_date": {
      "type": "date",
      "required": true
    },
    "end_date": {
      "type": "date",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Draft",
        "Active",
        "Closed"
      ],
      "default": "Draft"
    },
    "description": {
      "type": "text"
    }
  }
}
